    "summary": "REST API + OAS 3.1 data model for managing closed loops through automation. CRUD decision models, goals, workflows, activities; activate / deactivate loops; daisy-chain or hierarchically interlink loops.",
    "title": "Closed Loop Automation Management (CLAM)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "API root",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/closedLoop": {
      "get": {
        "operationId": "list_closed_loops_api_v1_closedLoop_get",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Pagesize",
              "type": "integer"
