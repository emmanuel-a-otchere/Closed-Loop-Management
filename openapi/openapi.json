        "title": "ClosedLoop",
        "type": "object"
      },
      "ClosedLoopCreate": {
        "additionalProperties": false,
        "properties": {
          "decisionModelRef": {
            "$ref": "#/components/schemas/DecisionModelRef"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "decisionModelRef"
        ],
        "title": "ClosedLoopCreate",
        "type": "object"
