      "ClosedLoopState": {
        "description": "Lifecycle state of a closed loop.\n\nThe transition diagram lives in ``docs/data-model/clam-data-model-1.0.md``\nunder \"State machine\". A transition is requested via\n``POST /api/v1/closedLoop/{id}/state`` and is validated by the API.",
        "enum": [
          "designed",
          "validated",
          "published",
          "active",
          "paused",
          "error",
          "retired"
        ],
        "title": "ClosedLoopState",
        "type": "string"
      },
      "ClosedLoopUpdate": {
