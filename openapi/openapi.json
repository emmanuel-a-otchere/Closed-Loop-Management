        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List closed loops",
        "tags": [
          "closedLoop"
        ]
      },
      "post": {
        "operationId": "create_closed_loop_api_v1_closedLoop_post",
        "requestBody": {
