      },
      "post": {
        "operationId": "create_decision_model_api_v1_decisionModel_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "CUSTOM": "#/components/schemas/CustomDecisionModel",
                    "MAPE": "#/components/schemas/MapeDecisionModel",
                    "OODA": "#/components/schemas/OodaDecisionModel"
                  },
                  "propertyName": "kind"
                },
