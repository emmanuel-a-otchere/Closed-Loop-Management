      "get": {
        "operationId": "get_state_api_v1_closedLoop__loopId__state_get",
        "parameters": [
          {
            "in": "path",
            "name": "loopId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Loopid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
