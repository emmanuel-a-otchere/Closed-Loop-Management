{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/clam/proposals/policy.schema.json",
  "title": "CLAM Proposed Policy or Constraint",
  "description": "Proposal only. A declaration does not itself enforce a policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "name",
    "kind",
    "scope",
    "rule",
    "enforcementResponsibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "proposal-0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "constraint",
        "permission",
        "prohibition",
        "operating-envelope",
        "approval-requirement",
        "recovery-rule"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "subjectRefs"
      ],
      "additionalProperties": false,
      "properties": {
        "subjectRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "actionTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "environmentRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "statement"
      ],
      "additionalProperties": true,
      "properties": {
        "statement": {
          "type": "string"
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ]
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effectiveUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "type": "string"
    },
    "enforcementResponsibility": {
      "type": "string",
      "description": "Identifies the component/role responsible for enforcement; CLAM declaration alone is not enforcement."
    },
    "violationResponse": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
