{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/clam/proposals/scenario.schema.json",
  "title": "CLAM Proposed Verification Scenario",
  "description": "Proposal only. Not a production or binding contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "name",
    "purpose",
    "subjectRef",
    "initialConditions",
    "acceptanceCriteria",
    "termination"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "proposal-0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "subjectRef": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "initialConditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "disturbances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "evaluationRef"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evaluationRef": {
            "type": "string"
          },
          "expected": {},
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "informational"
            ]
          }
        }
      }
    },
    "termination": {
      "type": "object",
      "required": [
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string"
        },
        "maxDurationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxCycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "expectedOutcome": {
      "type": [
        "object",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
